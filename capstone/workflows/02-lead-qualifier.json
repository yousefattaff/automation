        "method": "POST",
        "url": "={{ $env.SUPABASE_URL.replace(/[/]$/, '') + '/rest/v1/rpc/record_qualification' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_contact: {name:$json.contact_name,email:$json.contact_email,phone:$json.contact_phone || null}, p_scores: $json.scores, p_request_id: $json.request_id || null } }}",
