    {
      "id": "c8874712-582f-4735-b3af-cba4fedc5cbf",
      "name": "BANT Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        810,
        300
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"budget_score\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":5},\"authority_score\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":5},\"need_score\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":5},\"timeline_score\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":5},\"summary\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":2000},\"next_action\":{\"type\":\"string\",\"enum\":[\"schedule_demo\",\"nurture\",\"park\"]},\"speech\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":800}},\"required\":[\"budget_score\",\"authority_score\",\"need_score\",\"timeline_score\",\"summary\",\"next_action\",\"speech\"]}",
        "autoFix": false
      }
    },
    {
      "id": "d09cddd3-fb72-4da5-bde3-2d814bbfa9f2",
      "name": "Validate BANT scores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const s=$input.first().json.output;const p=$('Normalize qualification request').first().json;\nif(!s || typeof s!=='object')throw new Error('BANT output must be an object');\nfor(const k of ['budget_score','authority_score','need_score','timeline_score'])if(!Number.isInteger(s[k])||s[k]<1||s[k]>5)throw new Error('Invalid BANT score: '+k);\nconst composite=s.budget_score+s.authority_score+s.need_score+s.timeline_score;\nreturn [{json:{...p,scores:s,composite_score:composite,lead_category:composite>=14?'hot':composite>=8?'warm':'cold',next_action:composite>=14?'schedule_demo':composite>=8?'nurture':'park'}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "74430871-b666-48de-8582-66b631ae94dc",
