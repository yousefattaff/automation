        "jsCode": "const d=$input.first().json;if(d.success!==true || !d.contact_id || !['hot','warm','cold'].includes(d.lead_category))throw new Error('Supabase did not confirm qualification');\nreturn [{json:{...d,next_action:d.lead_category==='hot'?'schedule_demo':d.lead_category==='warm'?'nurture':'park'}}];"
      },
      "onError": "continueErrorOutput"
    },
