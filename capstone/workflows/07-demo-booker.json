    {
      "id": "bc064b90-7c3c-4d0c-8059-5b7dca6acf3c",
      "name": "Review supplied evidence",
      "type": "@n8n/n8n-nodes-langchain.toolThink",
      "typeVersion": 1.1,
      "position": [
        3320,
        660
