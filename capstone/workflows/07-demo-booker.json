        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {p_contact_id:$json.contact_id,p_deal_id:$json.deal_id,p_event_id:$json.event_id,p_booked_slot:$json.booked_slot} }}",
        "options": {
