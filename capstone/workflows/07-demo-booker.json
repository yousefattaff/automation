        "jsCode": "return [{json:{success:false,reason:'calendar_conflict',speech:'That time was just taken. Please try another demo time.',contact_id:$('Validate selected slot').first().json.contact_id,deal_id:$('Validate selected slot').first().json.deal_id}}];"
      }
    },
    {
      "id": "71de62a4-82cf-423c-8733-6b2826a5815e",
      "name": "Google Calendar create demo event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        4230,
        140
      ],
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "value": "={{ $('Validate selected slot').first().json.calendar_id }}",
          "mode": "list"
        },
        "start": "={{ $('Validate selected slot').first().json.slot.start }}",
        "end": "={{ $('Validate selected slot').first().json.slot.end }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "id": "={{ $('Validate selected slot').first().json.event_id }}",
          "summary": "={{ 'AccountAI demo - ' + $('Validate selected slot').first().json.contact.name }}",
          "description": "={{ 'AccountAI product demo. CRM deal: ' + $('Validate selected slot').first().json.deal_id }}",
          "attendees": [
            "={{ $('Validate selected slot').first().json.contact.email }}"
          ],
          "sendUpdates": "all"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "cda9cacc-f001-4344-87aa-ee55a596f04e",
      "name": "Validate new calendar event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4480,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$input.first().json;const p=$('Validate selected slot').first().json;if(!e.id||e.status==='cancelled'||!e.start?.dateTime||Date.parse(e.start.dateTime)!==Date.parse(p.slot.start))throw new Error('Calendar did not confirm the selected event');return [{json:{...p,reused:false,event:e,event_id:e.id,booked_slot:e.start.dateTime}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "546e866f-2120-40b6-b105-3e1e460f129a",
