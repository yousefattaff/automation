        "mode": "runOnceForAllItems",
        "jsCode": "const p=$input.first().json;return [{json:{success:true,contact_id:p.contact_id,deal_id:p.deal_id,event_id:p.event_id,booked_slot:p.booked_slot,calendar_link:p.event.htmlLink||'',reused:p.reused,contact:p.contact,timezone:p.timezone,confirmation_sent:false}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "cbeb343a-ed61-4d53-85e4-727f85f4846b",
