      "parameters": {
        "description": "Briefly compare supplied available slots to the prospect preference. This tool cannot change or verify availability."
      }
    },
    {
      "id": "4df5de71-0da8-44b3-803f-85907ed46da7",
      "name": "Demo slot parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        3550,
        660
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"slot_index\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":79},\"reason\":{\"type\":\"string\",\"maxLength\":200}},\"required\":[\"slot_index\",\"reason\"]}",
        "autoFix": false
      }
    },
    {
      "id": "4cf35940-9624-4705-bb78-1a7f53a22866",
      "name": "Validate selected slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3470,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r=$input.first().json.output;const p=$('Build available demo slots').first().json;if(!r||!Number.isInteger(r.slot_index))throw new Error('Invalid selected slot');const s=p.slots.find(s=>s.index===r.slot_index);if(!s||Date.parse(s.start)<Date.now())throw new Error('Selected slot is not a current verified candidate');return [{json:{...p,slot:s}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "ab51fb02-4ebf-49a2-b83c-030208034b17",
      "name": "Google Calendar final conflict check",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        3720,
        140
      ],
      "parameters": {
        "resource": "calendar",
        "operation": "availability",
        "calendar": {
          "__rl": true,
          "value": "={{ $('Validate selected slot').first().json.calendar_id }}",
          "mode": "list"
        },
        "timeMin": "={{ $json.slot.start }}",
        "timeMax": "={{ $json.slot.end }}",
        "options": {
          "outputFormat": "availability",
          "timezone": {
            "__rl": true,
            "value": "={{ $('Validate selected slot').first().json.timezone }}",
            "mode": "id"
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "44ac17a0-81d1-49dd-8e4d-76f206cbf1f7",
      "name": "Selected slot remains free",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        3970,
        140
      ],
      "parameters": {
        "conditions": {
          "options": {
