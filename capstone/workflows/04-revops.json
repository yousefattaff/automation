    {
      "parameters": {
        "content": "## Transactional RevOps\nRun supabase-schema.sql first. Select OpenRouter and Supabase API credentials; SUPABASE_URL must be the same project URL used in the credential.\nupsert_crm_contact normalizes email and domain, upserts the company before its contact, and preserves existing status and missing fields. A sourced email is required by this workflow to avoid ambiguous person matching.\nThe RPC is service-role-only. No credential values are embedded. Every handled failure calls workflow11 and returns success:false.",
        "width": 1080,
        "height": 300
      },
      "id": "f0b8a4ae-593a-497b-a037-17e45201a524",
      "name": "Setup and Operating Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
