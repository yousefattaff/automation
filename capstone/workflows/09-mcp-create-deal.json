        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/create_crm_deal' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {p_contact_email:$json.contact_email,p_title:$json.title,p_value:$json.value,p_request_id:$json.request_id} }}",
