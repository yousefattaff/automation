    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$input.first().json;\nconst email=String(input.contact_email||'').trim().toLowerCase();\nconst title=String(input.title||'').trim();\nconst value=input.value==null?null:Number(input.value);\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Valid contact_email is required');\nif(!title||title.length>240) throw new Error('A title of 1 to 240 characters is required');\nif(value!==null&&(!Number.isFinite(value)||value<0)) throw new Error('value must be a nonnegative number');\nreturn [{json:{contact_email:email,title,value,request_id:String(input.request_id||'').trim().slice(0,160)||null}}];"
      },
      "id": "69b7e7f9-1c1e-58de-876d-ec9d62d9ca9d",
      "name": "Validate Tool Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
