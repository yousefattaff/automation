      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/deals?id=eq.' + $json.deal_id + '&updated_at=eq.' + encodeURIComponent($json.activity_at) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {followup_drafted_at:$json.drafted_at,followup_draft_id:$json.draft_id} }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        }
      },
      "id": "356f4344-40d1-5099-84c2-dbffab04048a",
      "name": "Mark Deal Follow-up Drafted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2460,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if(!Array.isArray($json.body)||$json.body.length!==1)throw new Error('Deal changed while creating draft; inspect Gmail before retrying');const data=$('Prepare Draft Marker').item.json;return [{json:{success:true,deal_id:data.deal_id,draft_id:data.draft_id}}];"
      },
      "id": "c7b2c642-94ed-594c-ab76-2518b3eeb410",
      "name": "Draft Completed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2710,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results=$input.all().map(x=>x.json);const drafted=results.filter(x=>x.success===true&&x.draft_id);return [{json:{success:results.every(x=>x.success===true),drafts_created:drafted.length,failed:results.length-drafted.length,drafts:drafted,summary:drafted.length+' follow-up drafts created; '+(results.length-drafted.length)+' failed.'}}];"
      },
      "id": "31353725-6d4f-5305-8449-20dd566bb0fc",
      "name": "Summarize Follow-ups",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
