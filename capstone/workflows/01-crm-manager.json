      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\": \"object\", \"additionalProperties\": false, \"properties\": {\"success\": {\"type\": \"boolean\"}, \"summary\": {\"type\": \"string\"}, \"prospects_found\": {\"type\": \"integer\", \"minimum\": 0}, \"contacts_saved\": {\"type\": \"integer\", \"minimum\": 0}, \"drafts_created\": {\"type\": \"integer\", \"minimum\": 0}, \"errors\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"success\", \"summary\", \"prospects_found\", \"contacts_saved\", \"drafts_created\", \"errors\"]}"
      }
    },
    {
      "id": "73115f9e-0bc6-5d90-baae-69626e0d7548",
      "name": "Validate Manager Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        0
      ],
      "parameters": {
        "jsCode": "try {\n  const raw = $input.first().json.output;\n  const result = typeof raw === 'string' ? JSON.parse(raw) : raw;\n  if (!result || typeof result.success !== 'boolean' || !Array.isArray(result.errors)) throw new Error('Invalid manager summary');\n  for (const key of ['prospects_found','contacts_saved','drafts_created']) {\n    if (!Number.isInteger(result[key]) || result[key] < 0) throw new Error('Invalid summary count: '+key);\n  }\n  if (result.errors.length) result.success=false;\n  return [{json:result}];\n} catch (error) { return [{json:{success:false,error_message:error.message,node_name:'Validate Manager Result'}}]; }\n"
      }
    },
