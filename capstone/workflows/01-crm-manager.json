      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\ntry {\n  const text = String(input.text || '').trim();\n  if (text.length < 20) throw new Error('ICP PDF has no usable text. OCR scanned PDFs before upload.');\n  return [{json:{success:true,icp_text:text.slice(0,16000),context_truncated:text.length>16000,\n    run_id:String($execution.id),max_prospects:5}}];\n} catch (error) {\n  return [{json:{success:false,error_message:error.message,node_name:'Prepare Bounded Context'}}];\n}"
      }
    },
