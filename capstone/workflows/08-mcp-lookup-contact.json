    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nconst err = raw.error;\nconst message = String(typeof err === 'string' ? err : err?.message || raw.message || 'Workflow operation failed').slice(0,1600);\nreturn [{json:{success:false,error:message,workflow:{id:$workflow.id,name:$workflow.name},execution:{id:$execution.id,error:{message},lastNodeExecuted:err?.node?.name || raw.node_name || 'See parent execution'}}}];"
      },
