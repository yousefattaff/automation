        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/rest/v1/rpc/lookup_crm_contact' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {p_name:$json.name,p_email:$json.email} }}",
        "options": {
          "timeout": 30000
        }
      },
