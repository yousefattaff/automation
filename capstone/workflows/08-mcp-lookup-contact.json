    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input=$input.first().json;\nconst name=String(input.name||'').trim().slice(0,200);\nconst email=String(input.email||'').trim().toLowerCase();\nif(!name&&!email) throw new Error('Provide name or email');\nif(email&&!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) throw new Error('Invalid email');\nreturn [{json:{name:name||null,email:email||null}}];"
      },
      "id": "098164d1-d7f9-5663-9da2-6285e8a0d4f8",
      "name": "Validate Tool Input",
      "type": "n8n-nodes-base.code",
