            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Error": {
      "main": [
        [
          {
            "node": "Insert Supabase Error Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Supabase Error Log": {
      "main": [
        [
          {
            "node": "Prepare Pushover Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Pushover Alert": {
      "main": [
        [
          {
            "node": "Pushover Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pushover Error Alert": {
      "main": [
        [
          {
            "node": "Return Error Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
